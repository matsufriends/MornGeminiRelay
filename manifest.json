{
  "manifest_version": 3,
  "name": "MornGeminiRelay",
  "version": "0.3.5",
  "description": "Gemini の質問と回答を Slack のスレッドへ転送し、履歴を Markdown で保存する",
  "permissions": ["storage", "tabs", "downloads"],
  "host_permissions": ["https://slack.com/api/*", "https://files.slack.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://gemini.google.com/*"], "js": ["content.js"] },
    { "matches": ["https://gemini.google.com/*"], "js": ["canvas-bridge.js"], "world": "MAIN" },
    { "matches": ["https://*.scf.usercontent.goog/*"], "js": ["preview.js"], "world": "MAIN", "all_frames": true, "match_origin_as_fallback": true, "run_at": "document_start" }
  ],
  "action": { "default_popup": "popup.html" }
}
